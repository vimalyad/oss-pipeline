# Copy to config/identity.env, which is gitignored. Nothing here may be
# committed: the other logins in particular link the accounts together, which
# is the exact outcome identity isolation exists to prevent.
OSS_LOGIN="vimalyad"
OSS_NAME="Your Name"
OSS_EMAIL="NNNNNNNN+vimalyad@users.noreply.github.com"
OSS_KEYCHAIN_ACCOUNT="vimalyad"
OSS_KEYCHAIN_SERVICE="oss-pipeline-gh"

# The accounts that must never appear in a public artefact, and whose repos
# must never be contributed to from this one.
WORK_LOGIN=""
WORK_EMAIL=""
OTHER_LOGINS=""
OTHER_EMAILS=""
