# Copy to .env (mode 600). Never committed.
POSTGRES_PASSWORD=change-me

# The vimalyad PAT. Scopes: repo, workflow, gist, read:org.
# NOT delete_repo, and NOT account-level repo creation -- both are deliberately
# browser-only actions on this token.
GH_TOKEN=

OSS_LOGIN=vimalyad
OSS_NAME=
OSS_EMAIL=

WORKERS=3
API_PORT=8080
