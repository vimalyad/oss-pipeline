[Unit]
Description=OSS pipeline: one daily cycle (watch, autonomous approval, implement, discover, triage)
Documentation=file://%h/oss-pipeline/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/oss-pipeline
# The tools the engine shells out to: gh (mise), claude (~/.local/bin), go,
# git and docker. A user unit starts with a bare PATH.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/oss-pipeline/deploy/run-daily.sh
# Implementing several approved candidates, each built and tested in a
# container, takes hours on a slow day.
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
